# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# NOTE: LP_SLUG, LP_DISPLAY_NAME and NEXT_PUBLIC_GTM_ID are NO LONGER per-env vars.
# In apps/lps, the active LP is resolved at request time by hostname (or ?lp= override).
# See apps/lps/lib/registry.ts for the hostname → LP mapping.
# To add a GTM container per LP, add gtmId to the LpEntry in registry.ts.
